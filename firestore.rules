rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: feedback
    // Document ID: auto-generated
    // Fields:
    //   - uid: string (required) - User UID
    //   - adviceId: string (required) - Unique ID for the advice session
    //   - rating: int (required, 1-5) - User rating
    //   - comment: string (optional, max 500 chars) - Text feedback
    //   - mode: string (optional) - Perspective mode
    //   - need: string (optional) - User need
    //   - createdAt: timestamp (required) - Submission time
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "siesonn@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['uid', 'adviceId', 'rating', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'adviceId', 'rating', 'comment', 'mode', 'need', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 500)) &&
             (!('mode' in data) || (data.mode is string && data.mode.size() <= 50)) &&
             (!('need' in data) || (data.need is string && data.need.size() <= 50)) &&
             data.adviceId is string && data.adviceId.size() <= 100 &&
             data.createdAt == request.time;
    }

    match /feedback/{feedbackId} {
      // Users can only see their own feedback, admins can see all
      allow read: if isOwner(resource.data.uid) || isAdmin();
      
      // Users can create feedback for themselves
      allow create: if isAuthenticated() && isValidFeedback(request.resource.data);
      
      // Feedback is immutable once submitted
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Only admins can promote others to admin, or users can create their own profile as 'user'
      allow create: if isOwner(userId) && 
                      request.resource.data.keys().hasAll(['uid', 'email', 'role']) &&
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.role == 'user';
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
    }
  }
}
